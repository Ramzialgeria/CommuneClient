@model LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}
<section class="login-wrap">
    <div class="panel login-panel">
        <h1>تسجيل الدخول</h1>
        <p class="muted">أدخل بيانات حسابك للاتصال بخادم البلدية.</p>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" autocomplete="username" autofocus />
                <span asp-validation-for="UserName" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="validation"></span>
            </div>

            <button class="button button-primary button-block" type="submit">دخول</button>
        </form>
    </div>
</section>
